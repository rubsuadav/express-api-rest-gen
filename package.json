{
  "name": "express-api-rest-gen",
  "type": "module",
  "version": "4.12.1",
  "description": "A minimal CLI tool to generate a REST API with Express with JS or TS",
  "main": "dist/bin/index.js",
  "bin": "dist/bin/index.js",
  "exports": {
    ".": "./dist/bin/index.js",
    "./bin": "./dist/bin/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && node dist/bin/index.js",
    "dev": "tsx src/bin/index.ts",
    "test": "node --experimental-strip-types --experimental-test-coverage --test \"**/*.{spec,integration}.ts\"",
    "format": "npx prettier --write ."
  },
  "keywords": [
    "express",
    "api",
    "rest",
    "generator"
  ],
  "repository": {
    "url": "https://github.com/rubsuadav/express-api-rest-gen",
    "type": "git"
  },
  "homepage": "https://github.com/rubsuadav/express-api-rest-gen",
  "author": "rubsuadav",
  "license": "ISC",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "dependencies": {
    "chalk": "^5.6.0",
    "inquirer": "^12.9.3",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
